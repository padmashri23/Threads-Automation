# ===== MODEL PROVIDER (pick ONE; the app auto-detects whichever key is present) =====

# Option A — FREE (recommended): Google AI Studio, Gemini free tier, no credit card.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The free tier allows ~20 requests per DAY per model, and a research run uses ~12.
# The app therefore rotates through a pool of free flash models, skipping any that is used up.
# GEMINI_MODEL=gemini-3.7-flash
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash-lite

# Option B — FREE: Groq (or any OpenAI-compatible endpoint: OpenRouter, Mistral, Ollama).
# Groq keys at https://console.groq.com/keys
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# Option C — PAID: Anthropic Claude (best editorial judgment, billed per token).
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Force a provider when more than one key is set: gemini | openai-compatible | anthropic
# LLM_PROVIDER=gemini


# ===== OPTIONAL SOURCE KEYS (all free tiers; the app works without them) =====
# Reddit OAuth "script" app: enables upvote/comment counts. Without it, Reddit RSS is used.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=threads-ai-editor/1.0 by yourname
# GitHub personal token (no scopes needed): higher rate limits for repo search
# GITHUB_TOKEN=
# YouTube Data API v3 key (free quota): search-wide video discovery beyond the channel list
# YOUTUBE_API_KEY=
# X / Twitter bearer token (X charges for API access; skip for a free setup)
# X_BEARER_TOKEN=
